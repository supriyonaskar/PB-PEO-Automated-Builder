integrator              = md
dt                      = 0.002
nsteps                  = 500000000 ; 1 microsecond
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 50000     ; 100 ps
nstcalcenergy           = 100
nstenergy               = 5000
nstlog                  = 5000
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
dispcorr                = no
;
tcoupl                  = v-rescale
tc_grps                 = MEMB   SOL_ION
tau_t                   = 1.0 1.0
ref_t                   = 310.15 310.15
;
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 1.0     1.0
;
pbc                     = xyz
gen_vel                 = no
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = MEMB   SOL_ION
